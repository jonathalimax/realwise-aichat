# Target production environment values for the single-origin, path-routed deployment.
# None of this is applied automatically — actual DNS, reverse-proxy routing rules, TLS
# certificates, and third-party redirect-URI re-registration (Google Calendar OAuth,
# Stripe webhook endpoint) are NOT done by this file and require manual founder action
# at deploy time. This file only documents the target values to configure then.

# Single origin — all apps and the API share chat.realwise.com.br (path-routed).
# Each basePath below MUST match both the reverse-proxy prefix AND the app's next.config.mjs basePath.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CHAT_URL=https://chat.realwise.com.br
NEXT_PUBLIC_DASHBOARD_URL=https://chat.realwise.com.br/app
NEXT_PUBLIC_ADMIN_URL=https://chat.realwise.com.br/admin
NEXT_PUBLIC_MARKETING_URL=https://chat.realwise.com.br/site
DASHBOARD_URL=https://chat.realwise.com.br/app
CORS_ALLOWED_ORIGINS=https://chat.realwise.com.br
GOOGLE_CALENDAR_REDIRECT_URI=https://chat.realwise.com.br/api/calendar/oauth/callback
TRANSACTIONAL_FROM_EMAIL=Realwise <avisos@mail.realwise.com.br>
