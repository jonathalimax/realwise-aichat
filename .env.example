DATABASE_URL=postgresql://user:password@localhost:5432/realwise

SESSION_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DASHBOARD_URL=http://localhost:3000

# Comma-separated list of origins allowed to make credentialed requests to the API (CORS).
# Required in production — localhost ports for dashboard/admin/chat/marketing are allowed by default in dev only.
CORS_ALLOWED_ORIGINS=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_MARKETING_URL=http://localhost:3007

# Google Calendar sync — leave blank to keep the feature disabled (safe no-op fallback)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/calendar/oauth/callback

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

MANAGED_API_URL=https://openrouter.ai/api/v1/chat/completions
MANAGED_API_KEY=
MANAGED_MODEL=qwen/qwen-2.5-7b-instruct

INFERENCE_GATEWAY_URL=http://localhost:3002
INFERENCE_GATEWAY_TOKEN=

REDIS_URL=redis://localhost:6379
EMBEDDING_MODEL=nomic-embed-text
# Must be an ABSOLUTE path shared between apps/api and apps/worker (they read/write the same files).
LOCAL_STORAGE_DIR=/absolute/path/to/aicom/storage

SEED_ADMIN_PHONE=
SEED_ADMIN_NAME=Founder

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAT_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

CALENDAR_TOKEN_ENCRYPTION_KEY=

